{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ytl-site",
  // Static Astro output. No Worker script required.
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
