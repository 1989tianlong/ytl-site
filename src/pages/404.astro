---
import Base from '../layouts/Base.astro';
---

<Base title="未找到" description="没有这一页。">
  <header class="page-heading manual-grid">
    <div class="rail page-rail">
      <p class="type-meta text-muted">404</p>
    </div>
    <div class="page-main">
      <h1 class="type-title text-primary">没有这一页。</h1>
      <p class="page-description type-body text-muted">地址可能写错了，或内容还没放上来。</p>
      <a class="more-link type-ui text-accent" href="/">回到首页</a>
    </div>
  </header>
</Base>
