---
interface Props {
  index: string;
  label: string;
  id?: string;
}

const { index, label, id } = Astro.props;
---

<section class="chapter manual-chapter manual-grid" id={id}>
  <div class="rail page-rail">
    <p class="type-meta text-muted">{index} / {label}</p>
    <slot name="glyph" />
  </div>
  <div class="chapter-main">
    <slot />
  </div>
</section>
