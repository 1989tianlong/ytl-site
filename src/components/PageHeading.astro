---
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<header class="page-heading">
  <p class="rail type-meta text-muted">{index} / {label}</p>
  <div class="page-main">
    <h1 class="type-title text-primary">{title}</h1>
    <p class="page-description type-body text-muted">
      <slot />
    </p>
  </div>
</header>
