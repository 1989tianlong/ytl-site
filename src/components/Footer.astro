---
import { site } from '../data/site';
import AsciiDivider from './AsciiDivider.astro';
---

<footer class="site-footer type-ui text-muted">
  <AsciiDivider />
  <div class="footer-row">
    <nav class="footer-links" aria-label="页脚链接">
      <a href={site.x.url} rel="noopener noreferrer">X @{site.x.username}</a>
      <a href={site.github.url} rel="noopener noreferrer">GitHub {site.github.login}</a>
      <a href={site.hubs.vitaminclaw} rel="noopener noreferrer">VitaminClaw</a>
    </nav>
    <div class="setting-switch" role="group" aria-label="主题">
      <button
        class="setting-option text-setting-control type-ui"
        type="button"
        data-theme-option="light"
      >
        <span class="setting-option-label">浅色</span>
      </button>
      <button
        class="setting-option text-setting-control type-ui"
        type="button"
        data-theme-option="dark"
      >
        <span class="setting-option-label">深色</span>
      </button>
    </div>
  </div>
  <p class="type-meta text-muted">
    <span class="cursor-text">
      <span class="cursor-label">{site.tagline} · {site.location}</span>
      <span class="terminal-cursor" aria-hidden="true"></span>
    </span>
  </p>
</footer>
