---
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title,
  description = site.description,
  home = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfb" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={`@${site.x.username}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme.js"></script>
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      alternateName: [site.github.name, site.x.name],
      url: Astro.site?.href,
      description: site.description,
      address: { '@type': 'PostalAddress', addressLocality: site.location },
      sameAs: [site.github.url, site.x.url, site.hubs.vitaminclaw],
    })} />
  </head>
  <body>
    <a class="skip-link type-ui" href="#main">跳到正文</a>
    <div class:list={['site-shell', home && 'home-shell']}>
      <Header />
      <main class="site-main" id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
